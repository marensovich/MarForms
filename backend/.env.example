# Local development environment — matches ../docker-compose.yml
# (postgres: db=forms, user=postgres, password=postgres, port 5432).
# Backend runs on the host, not in Docker, so it talks to Postgres via localhost.
#
# Copy this file to `.env` and fill in the real values. `.env` is gitignored —
# never commit real secrets.

SPRING_APPLICATION_NAME=marforms-backend
HOST_APP_PORT=8090

# ── Database (docker-compose postgres service) ──────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/forms
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48 — fine for dev, rotate for prod.
JWT_SECRET=replace-with-a-generated-secret
JWT_EXPIRATION=86400000

# ── Frontend ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Discord OAuth2 ──────────────────────────────────────────────────────────
# Create an application at https://discord.com/developers/applications,
# add this exact redirect URI under OAuth2 > Redirects, then fill these in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8090/login/oauth2/code/discord

# Bot user token — Developer Portal > your app > Bot > Reset Token.
# Needed for the bot module (listing channels, creating webhooks, kick
# detection). Leave blank to run without bot features (e.g. in tests).
DISCORD_BOT_TOKEN=

# Where Discord redirects after the owner picks a server on the bot-install
# consent screen — must also be registered under OAuth2 > Redirects.
DISCORD_BOT_INSTALL_REDIRECT_URI=http://localhost:8090/api/v1/guilds/connect/callback
